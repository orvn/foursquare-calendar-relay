# google cloud oauth client, type desktop
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
# written by google auth script
GOOGLE_REFRESH_TOKEN=

# needed if CF user has more than one account
# CLOUDFLARE_ACCOUNT_ID=

# optional uptimerobot monitor
HEARTBEAT_URL=

# any value logs events instead of writing to cal
# DRY_RUN=1
